# ============================================================
# rd-knowledge-svc 环境变量样例
# 用法：cp .env.example .env 然后填真实密钥
# .env 已在 .gitignore 里，绝不提交
# ============================================================

# 应用
APP_NAME=rd-knowledge-svc
APP_ENV=dev
APP_DEBUG=true

# PostgreSQL — 复用项目一的 PG 实例，P2 用独立的 rd_knowledge 库
DB_HOST=localhost
DB_PORT=15433
DB_USER=rdagent
DB_PASSWORD=rdagent123
DB_NAME=rd_knowledge

# Redis Stack — 复用项目一的 Redis（key 前缀隔离）
REDIS_HOST=localhost
REDIS_PORT=16380
REDIS_PASSWORD=
REDIS_DB=0

# MinIO — 复用项目一的 MinIO（P2 用 knowledge-docs bucket）
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-docs
MINIO_SECURE=false

# Milvus — 复用项目一的 Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19540

# Neo4j — 复用项目一的 Neo4j（只读账号）
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=rdagent123

# ---------------- 模型 ----------------
# ★ 主链路（生成/Query改写/HyDE/GraphRAG/幻觉检测/VL图片摘要/LLM重排/评测裁判）
#   统一走 DeepSeek 的 OpenAI 兼容端点；DashScope 保留给向量化 embedding 与
#   qwen3-rerank 精排（RERANK_PROVIDER=dashscope，默认）
DASHSCOPE_API_KEY=sk-xxxxxxxx              # 向量化（EMBEDDING_MODEL）+ qwen3-rerank 精排使用
DEEPSEEK_API_KEY=sk-xxxxxxxx               # 主链路密钥
# CHAT_API_KEY=                            # 可选：显式覆盖主链路密钥（接其他 OpenAI 兼容供应商）
BASE_URL_CHAT=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-chat                   # 可换 deepseek-reasoner（推理模型，延迟更高）
EMBEDDING_MODEL=text-embedding-v3          # DashScope 向量化，不随主链路切换

# RAG 检索
# 初召 / 精排条数。★ 这两项同时被在线链路与离线消融脚本读取，改这里两边同时生效。
RAG_TOP_K=20
RAG_RERANK_TOP_K=5
# Rerank 后按分数断崖动态截断。默认 false（固定取 RAG_RERANK_TOP_K 条）。
# ★ 实测：开 → 证据中位 2 条、页级召回 89.1%、有据性 0.949；
#        关 → 固定 5 条、    页级召回 93.5%、有据性 0.965。详见 runbook 4.4.3
RAG_DYNAMIC_TOPK=false
# 精排后端：dashscope=qwen3-rerank 专用模型（默认，分数确定性、可标定拒答阈值）
#            / deepseek=LLM 清单式重排 / off=RRF 序直通
RERANK_PROVIDER=dashscope
# 返回给前端的 contexts 单条字符上限（同时是缓存载荷与在线评测的上下文口径）
RAG_CONTEXT_MAX_CHARS=1500
# true 时检索请求必须带 model_code，否则 400。车型隔离是安全事故，生产建议开启
RAG_REQUIRE_MODEL_CODE=false
# 低置信拒答阈值：文档通道 top-1 分数低于此值时直接答"没有"，不调生成 LLM。
# 0 = 不启用。★ 必须在本项目 reranker 的分数尺度上标定（τ=0.95 系 deepseek 重排
#   时代实测，dashscope 分数尺度上未标定、不可沿用），换 reranker 要重标
#   —— 见 docs/runbook.md 4.4.1
RAG_REFUSE_THRESHOLD=0

# ── 文档级 ACL（权限在检索之前生效：谓词并进 Milvus 查询，无权内容不进候选集）──
# 关闭仅用于演练/排障；APP_ENV=prod 时为 false 会拒绝启动
DOC_ACL_ENABLED=true
# 入库未显式指定 acl_roles 时的默认可见角色（逗号分隔）。
# ★ 留空 = 仅 admin 可见（fail-closed）。可选值：engineer,business,aftersales,customer
DOC_ACL_DEFAULT_ROLES=
# 图谱节点级 ACL 未实现（Neo4j Community 无细粒度权限、Cypher 由 LLM 生成）。
# 非 admin 默认拒绝 graph_rag 通道；置 true = 显式承担无隔离风险（prod 拒绝启动）
GRAPH_ACL_ALLOW_NON_ADMIN=false

# 图片 VL 摘要（入库时对每张图片调用 DeepSeek 视觉模型生成描述写入 markdown alt）
VL_MODEL=deepseek-flash
VL_BASE_URL=https://api.deepseek.com/v1
# VL_API_KEY=                              # 空则回退主链路密钥 DEEPSEEK_API_KEY
VL_TIMEOUT=60
VL_CONCURRENCY=2      # VL 并发上限（批量入库限流）
# EMBED_CONCURRENCY=2  # embedding 并发上限
IMAGE_SUMMARIZE_ENABLED=true

# 公式原图对照（双通道）：入库时额外跑一遍 formula_enable=false 解析取公式原图，
# 嵌入 markdown 供人眼对照，防 LaTeX 识别不准确。代价：解析时间约 2 倍。
FORMULA_IMAGE_ENABLED=true

# 表格原图对照（bbox 裁剪）：用 PyMuPDF 渲染页面裁剪出表格原图嵌入 markdown，
# 防复杂表格（colspan/rowspan）OCR 串行/丢列；跨页表格每个页片段各裁一张。
TABLE_ORIGINALS_ENABLED=true
# 表格 VL 增强：对每张表格原图调用 VL 生成语义摘要（写入 chunk 可检索文本）
# + 净化 Markdown 转录（与 MinerU HTML 并排互查）；失败 fail-open 保留原样
TABLE_VL_ENABLED=true

# API 限流（按 user_id 滑动窗口，仅重负载端点）
# RATE_LIMIT_BACKEND=redis（ZSET 跨 worker）/ memory（进程内 deque）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# 按用户/天的 token 配额（成本止损；0 = 不限额）。
# 与限流互补：请求数限流挡不住「低频但每次烧几万 token」的调用。
USER_DAILY_TOKEN_QUOTA=0

# 删除文档（不可逆，含 MinIO 原文）要求的角色白名单，逗号分隔。
# 留空 = 不校验（仅限开发环境；生产留空会被 prod 安全校验以外的流程放过，务必显式配置）
DOC_DELETE_REQUIRED_ROLES=admin

# 软删文档保留天数（0 = 永久保留）。
# 大于 0 时由 `python scripts/maintenance.py retention --apply` 清理（建议 crontab 定时）
DOC_RETENTION_DAYS=0

# 查询缓存（知识检索结果，Redis；文档/图谱相对静态，缓存安全）
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

# 入库异步任务（Redis Stream + 后台 worker）
# 启动 worker：python -m src.rag.ingestion.worker
INGEST_STREAM=alm_ingest:jobs
INGEST_CONSUMER_GROUP=alm_ingest_workers
INGEST_STREAM_MAX_LEN=1000
INGEST_MAX_RETRIES=2
# worker 单进程并发消费数（横向扩容=多起 worker 进程）；PEL 回收阈值须大于单条消息最长处理时间
INGEST_CONCURRENCY=1
INGEST_PEL_MIN_IDLE_S=1800

# 韧性（超时/重试/熔断）
# 单检索通道超时（秒），超时按失败降级；通道临时失败退避重试
RETRIEVAL_CHANNEL_TIMEOUT=20
RETRIEVAL_CHANNEL_RETRIES=2
# 熔断：连续失败 N 次打开，reset 窗口（秒）过后放一个探针
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT=30

# ---------------- 日志 ----------------
LOG_LEVEL=DEBUG
LOG_DIR=logs

# ChatBI 独立服务（nl2sql 通道 HTTP 调用）
CHATBI_URL=http://localhost:8004
CHATBI_PROJECT_ID=rd_agent

# ---------------- 认证（生产必改）----------------
# header：开发期，直接信任网关透传的 X-User-* 请求头（网关必须剥离外部同名头！）
# jwt：验 Authorization: Bearer <token>，密钥从本文件注入
AUTH_MODE=header
# prod 且 header 模式：确认网关已剥离外部 X-User-* 同名头后，必须显式改为 true
GATEWAY_TRUSTED=false
JWT_SECRET=                      # HS256 验签密钥（AUTH_MODE=jwt 时必填，openssl rand -hex 32）
JWT_PUBLIC_KEY=                  # RS256 公钥 PEM（上游网关签发时用，\n 转义或单行）
JWT_ALGORITHM=HS256
JWT_REVOKED_SECRETS=             # 已泄露历史密钥黑名单（逗号分隔；部署侧注入，源码不落字面量）

# 跨域：逗号分隔的显式 origin 列表；生产必须收敛，禁止 *
CORS_ORIGINS=*

# 上传限制
UPLOAD_MAX_MB=200
ALLOWED_UPLOAD_SUFFIXES=.pdf,.doc,.docx,.md,.txt

# PostgreSQL 连接池（DB_POOL_ENABLED=false 回退 NullPool 每请求新建连接）
DB_POOL_ENABLED=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis 连接池
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_CONNECTIONS=100

# Milvus / Neo4j 超时
MILVUS_TIMEOUT=10
NEO4J_CONNECTION_TIMEOUT=5
NEO4J_MAX_POOL_SIZE=50
NEO4J_QUERY_TIMEOUT=10

# LLM 超时（秒）
LLM_REQUEST_TIMEOUT=120
GENERATION_TIMEOUT=120
HALLUCINATION_TIMEOUT=30
RERANK_TIMEOUT=10

# MinerU 解析服务
MINERU_API_URL=http://localhost:8000
MINERU_BACKEND=hybrid-auto-engine
MINERU_TIMEOUT=900

# Query 改写（检索主链路第一步）
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT=8
QUERY_REWRITE_MAX_SUB_QUERIES=3

# 熔断状态外置 Redis（多副本共享；Redis 异常自动降级进程内）
CIRCUIT_REDIS_ENABLED=true

# MinIO 桶公共读（前端 <img> 直连）。★ 生产必须 false：
# 公共读让原文/图片 URL 可被任意人访问，等于绕过文档级权限。
# APP_ENV=prod 时设为 true 会直接拒绝启动。
MINIO_PUBLIC_READ=false

# 在线评测
TRULENS_ENABLED=true
EVAL_SAMPLE_RATE=0.1
# JUDGE_MODEL=                   # 评测裁判模型；空则跟随 CHAT_MODEL（换独立模型消除自评偏差）

# 模型定价（USD/1M，成本核算；deepseek-flash 峰时参考，谷时减半，精确值见 DeepSeek 价目页）
MODEL_PRICING_INPUT=0.30
MODEL_PRICING_OUTPUT=1.20
